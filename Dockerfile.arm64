# syntax=docker/dockerfile:1
# ARM64 (aarch64) build for NVIDIA Grace Hopper (Isambard-AI).
# Standard pip torch wheels for aarch64 are CPU-only; NGC provides CUDA-enabled builds.
# PIP_EXTRA_INDEX_URL is intentionally absent — torch is pre-installed in the NGC base
# and the cu121 x86 index has no useful aarch64 wheels anyway.

FROM nvcr.io/nvidia/pytorch:25.05-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    HF_HOME=/cache

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libhdf5-dev \
    libboost-all-dev \
    libgl1 \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt-dev \
    pkg-config \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app

# biotite has no ARM64 wheels; build from source using the global env to avoid
# isolation issues in the NGC ARM64 container.
RUN pip install --no-cache-dir "cython>=3.0" hatchling "hatch-vcs==0.4" "hatch-cython==0.5.0"
RUN pip install --no-cache-dir --no-build-isolation biotite
RUN pip install --no-cache-dir hydride
RUN pip install --no-cache-dir matplotlib pydssp logomaker gemmi
RUN pip install --no-cache-dir scikit-learn hydra-core edit_distance pytorch-lightning
RUN pip install --no-cache-dir rdkit pandas pdbeccdutils einx einops mashumaro
RUN pip install --no-cache-dir "nvidia-ml-py>=12.535.133" huggingface_hub biopython
RUN pip install --no-cache-dir "cuequivariance_ops_cu12>=0.5.0" "cuequivariance_ops_torch_cu12>=0.5.0" "cuequivariance_torch>=0.5.0"
RUN pip install --no-cache-dir --no-deps -e /app

ARG DOWNLOAD_WEIGHTS=false

RUN mkdir -p "${HF_HOME}" && \
    if [ "${DOWNLOAD_WEIGHTS}" = "true" ]; then \
    boltzgen download all --cache "${HF_HOME}" --force_download; \
    fi

ARG USERNAME=boltzgen
ARG USER_UID=1000
ARG USER_GID=1000

RUN getent group ${USER_GID} || groupadd --gid ${USER_GID} ${USERNAME} && \
    id -u ${USER_UID} > /dev/null 2>&1 || useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME}

RUN mkdir -p "${HF_HOME}" && chown -R ${USER_UID}:${USER_GID} "${HF_HOME}"

USER ${USERNAME}

WORKDIR /workspace
