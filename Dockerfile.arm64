# syntax=docker/dockerfile:1
# ARM64 (aarch64) build for NVIDIA Grace Hopper (Isambard-AI).
# Standard pip torch wheels for aarch64 are CPU-only; NGC provides CUDA-enabled builds.
# PIP_EXTRA_INDEX_URL is intentionally absent — torch is pre-installed in the NGC base
# and the cu121 x86 index has no useful aarch64 wheels anyway.

FROM nvcr.io/nvidia/pytorch:25.01-py3

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    HF_HOME=/cache

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libhdf5-dev \
    libboost-all-dev \
    libgl1 \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt-dev \
    pkg-config \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app

# Install boltzgen's strict pins before the main install so pip resolves them
# against the already-present NGC packages rather than the other way around.
# torch >=2.4.1 is already satisfied by NGC's 2.6.0 and will not be reinstalled.
RUN pip install --no-cache-dir "numpy==2.0.2" "numba==0.61.0"

RUN pip install --no-cache-dir -e /app

ARG DOWNLOAD_WEIGHTS=false

RUN mkdir -p "${HF_HOME}" && \
    if [ "${DOWNLOAD_WEIGHTS}" = "true" ]; then \
    boltzgen download all --cache "${HF_HOME}" --force_download; \
    fi

ARG USERNAME=boltzgen
ARG USER_UID=1000
ARG USER_GID=1000

RUN getent group ${USER_GID} || groupadd --gid ${USER_GID} ${USERNAME} && \
    id -u ${USER_UID} > /dev/null 2>&1 || useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME}

RUN mkdir -p "${HF_HOME}" && chown -R ${USER_UID}:${USER_GID} "${HF_HOME}"

USER ${USERNAME}

WORKDIR /workspace
